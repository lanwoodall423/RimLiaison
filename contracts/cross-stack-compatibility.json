{
  "schemaVersion": "rimtest-cross-stack-compatibility/v1",
  "repositories": {
    "rimLiaison": {
      "repository": "lanwoodall423/RimLiaison",
      "revisionPolicy": "workflow-sha"
    },
    "devBridge2": {
      "repository": "lanwoodall423/DevBridge2",
      "revision": "3643c7159e918e9932ee306a9f337308f02cd6fe"
    }
  },
  "components": {
    "rimContext": {
      "source": "internal",
      "projects": [
        "src/RimContext.Core/RimContext.Core.csproj",
        "src/RimContext.Cli/RimContext.Cli.csproj",
        "tests/RimContext.Tests/RimContext.Tests.csproj"
      ]
    },
    "rimError": {
      "source": "internal",
      "projects": [
        "src/RimError.Core/RimError.Core.csproj",
        "src/RimError.Cli/RimError.Cli.csproj",
        "tests/RimError.Core.Tests/RimError.Core.Tests.csproj"
      ]
    }
  },
  "contracts": {
    "rimContextAffected": {
      "schemaVersion": "rimctx/v1",
      "required": ["status", "command", "data", "meta"]
    },
    "devBridgeModDevelopment": {
      "schemaVersion": "devbridge-mod-development/v1",
      "required": [
        "success",
        "project",
        "transactionId",
        "workflowId",
        "artifactFreshness.sourceFingerprint",
        "artifactFreshness.builtArtifactSha256",
        "artifactFreshness.deployedArtifactSha256",
        "artifactFreshness.deploymentDecision",
        "artifactFreshness.generation",
        "artifactFreshness.loadedArtifactFreshnessProven"
      ]
    },
    "devBridgeRecipeRun": {
      "schemaVersion": "devbridge-test-recipe-run/v1",
      "required": [
        "success",
        "recipe",
        "runId",
        "workflowId",
        "generation",
        "leaseId",
        "operations"
      ]
    },
    "devBridgeCapabilities": {
      "schemaVersion": "rimbridge-tools/v1",
      "required": ["success", "result.tools"]
    },
    "devBridgeLogsQuery": {
      "schemaVersion": "devbridge-logs-query/v1",
      "required": ["contract", "success", "generation", "available", "truncated", "records"]
    },
    "rimErrorIntegration": {
      "schemaVersion": "rimerror-integration/v1",
      "required": ["devBridge.schemaVersion", "devBridge.workflowId", "devBridge.runId", "devBridge.generation", "rimBridge.operations"]
    },
    "rimTestSuite": {
      "schemaVersion": "rimtest-suite-result/v1",
      "required": ["status", "suite", "passed", "failed", "artifactFreshness.loadedArtifactFreshnessProven"]
    },
    "rimTestCapabilities": {
      "schemaVersion": "rimtest-capabilities/v1",
      "required": ["status", "count", "capabilities"]
    }
  },
  "limits": {
    "maxResultBytes": 8192,
    "maxDiagnosticBytes": 8192,
    "maxIntegrationBytes": 8192
  },
  "update": "Change only the external DevBridge2 revision in a deliberate compatibility update, run scripts/cross-stack-contract.tests.ps1, and review the resulting contract report.",
  "scope": {
    "offline": "This gate proves the no-RimWorld composition and wire contracts using a deterministic DevBridge-compatible fake host.",
    "live": "Real RimWorld/RimBridgeServer compatibility remains covered only by DevBridge2/scripts/live-stack-smoke.ps1 on the configured self-hosted runner."
  }
}
