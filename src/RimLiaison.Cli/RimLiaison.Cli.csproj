<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>rimliaison</AssemblyName>
    <RootNamespace>RimLiaison</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <ProjectReference Include="..\RimContext.Core\RimContext.Core.csproj" />
    <ProjectReference Include="..\RimError.Core\RimError.Core.csproj" />
    <EmbeddedResource Include="..\..\templates\AGENTS.md"
                      LogicalName="RimLiaison.CanonicalAgents.md" />
    <ProjectReference Include="..\RimDev.Contracts\RimDev.Contracts.csproj" />
  </ItemGroup>
</Project>
