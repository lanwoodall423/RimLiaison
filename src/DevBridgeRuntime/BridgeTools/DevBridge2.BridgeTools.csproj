<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>DevBridge2.BridgeTools</RootNamespace>
    <AssemblyName>DevBridge2.BridgeTools</AssemblyName>
    <Version>$(DevBridgeProductVersion)</Version>
    <AssemblyVersion>$(DevBridgeAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(DevBridgeAssemblyVersion)</FileVersion>
    <InformationalVersion>$(DevBridgeProductVersion)</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <RimBridgeSdkPath Condition="'$(RimBridgeSdkPath)' == ''"></RimBridgeSdkPath>
    <OutputPath>$(DevBridgeRuntimePackageRoot)1.6\BridgeTools\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the checked-in net472 package lock graph explicit on Windows and Linux.
         This is a compile-time reference pack, never a shipped runtime dependency. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="RimBridgeServer.Sdk" Condition="'$(RimBridgeSdkPath)' != '' and Exists('$(RimBridgeSdkPath)')">
      <HintPath>$(RimBridgeSdkPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="RimBridgeServer.Sdk" Version="2.0.0" PrivateAssets="all" ExcludeAssets="runtime"
                      Condition="'$(RimBridgeSdkPath)' == '' or !Exists('$(RimBridgeSdkPath)')" />
  </ItemGroup>
</Project>
