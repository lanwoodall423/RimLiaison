<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DevBridge2</RootNamespace>
    <AssemblyName>DevBridge2</AssemblyName>
    <Version>$(DevBridgeProductVersion)</Version>
    <AssemblyVersion>$(DevBridgeAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(DevBridgeAssemblyVersion)</FileVersion>
    <InformationalVersion>$(DevBridgeProductVersion)</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath Condition="'$(OutputPath)' == ''">$(DevBridgeRuntimePackageRoot)1.7\Assemblies\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4990-unstable" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Coordinator.Core\State\DevBridgeSchemaVersions.cs" Link="DevBridgeSchemaVersions.cs" />
    <Compile Include="..\Coordinator.Core\QuicktestActivationCore.cs" Link="QuicktestActivationCore.cs" />
    <Compile Include="..\Coordinator.Core\QuicktestFailureArtifact.cs" Link="QuicktestFailureArtifact.cs" />
  </ItemGroup>
</Project>
