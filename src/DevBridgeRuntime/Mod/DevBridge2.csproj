<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>DevBridge2</RootNamespace>
    <AssemblyName>DevBridge2</AssemblyName>
    <Version>$(DevBridgeProductVersion)</Version>
    <AssemblyVersion>$(DevBridgeAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(DevBridgeAssemblyVersion)</FileVersion>
    <InformationalVersion>$(DevBridgeProductVersion)</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath Condition="'$(OutputPath)' == ''">$(DevBridgeRuntimePackageRoot)1.6\Assemblies\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472"
                      Version="1.0.3"
                      PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Coordinator.Core\State\DevBridgeSchemaVersions.cs" Link="DevBridgeSchemaVersions.cs" />
    <Compile Include="..\Coordinator.Core\QuicktestActivationCore.cs" Link="QuicktestActivationCore.cs" />
    <Compile Include="..\Coordinator.Core\QuicktestFailureArtifact.cs" Link="QuicktestFailureArtifact.cs" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- This gate is for the game-backed Mod project only. Offline tooling
       projects do not require RimWorld game assemblies to build or test. -->
  <Target Name="ValidateRealRimWorldManagedAssemblies"
          BeforeTargets="ResolveReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Code="RLW0001"
           Condition="'$(RimWorldManagedDir)' == ''"
           Text="RimWorld managed assemblies are not configured. Set /p:RimWorldManagedDir, RIMWORLD_MANAGED_DIR, RIMWORLD_MANAGED_PATH, RIMWORLD_MANAGED_ASSEMBLIES or RIMWORLD_ROOT to the real installed game." />
    <Error Code="RLW0002"
           Condition="'$(RimWorldManagedDir)' != '' and !Exists('$(RimWorldManagedDir)')"
           Text="The configured RimWorld managed assembly directory does not exist. Verify the actual installed RimWorld path." />
    <Error Code="RLW0003"
           Condition="'$(RimWorldManagedDir)' != '' and Exists('$(RimWorldManagedDir)') and !Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')"
           Text="The installed RimWorld Assembly-CSharp.dll is missing from the managed directory. A real game installation is required." />
    <Error Code="RLW0004"
           Condition="'$(RimWorldManagedDir)' != '' and Exists('$(RimWorldManagedDir)') and !Exists('$(RimWorldManagedDir)\UnityEngine.CoreModule.dll')"
           Text="The installed RimWorld UnityEngine.CoreModule.dll is missing from the managed directory. A real game installation is required." />
  </Target>
</Project>
